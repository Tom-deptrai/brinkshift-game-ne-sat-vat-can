# Brinkshift repository layout
# Repo root = full project workspace; Unity project lives in /Brinkshift.

.utmp/
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Explicit nested Unity project paths
/Brinkshift/[Ll]ibrary/
/Brinkshift/[Tt]emp/
/Brinkshift/[Oo]bj/
/Brinkshift/[Bb]uild/
/Brinkshift/[Bb]uilds/
/Brinkshift/[Ll]ogs/
/Brinkshift/[Uu]ser[Ss]ettings/
/Brinkshift/[Mm]emoryCaptures/
/Brinkshift/[Rr]ecordings/

*.log
*.blend1
*.blend1.meta

# OS junk
.DS_Store
**/.DS_Store

# IDE/editor caches
.vs/
.vscode/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user

# Unity generated / crash files
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
mono_crash.*

# Build outputs
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables / generated data
ServerData/
[Aa]ssets/StreamingAssets/aa*
[Aa]ssets/AddressableAssetsData/link.xml*
[Aa]ssets/Addressables_Temp*
[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes / caches
[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
[Aa]ssets/[Ss]ceneDependencyCache*
